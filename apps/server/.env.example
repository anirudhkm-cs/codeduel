PORT=4000
DATABASE_URL=postgres://codeduel:codeduel@localhost:5432/codeduel

# Which sandbox runs submissions:
#   local  - runs code directly on your machine with timeouts. DEV ONLY, never in production.
#   judge0 - sends code to a Judge0 instance (see infra/judge0).
EXECUTOR=local
JUDGE0_URL=http://localhost:2358
# Only needed if your Judge0 has AUTHN_TOKEN set
JUDGE0_AUTH_TOKEN=

CORS_ORIGIN=http://localhost:5173
